/build*
/tmp/
/.*
# ...but not the CI definitions. `/.*` ignores every dotfile at the root, and
# .github is one: the workflows already tracked are unaffected (ignore rules do
# not apply to tracked files), so a NEW workflow or action would be silently
# dropped from a commit with nothing to notice.
!/.github/
# Archived/superseded docs — kept on disk, never tracked
docs/archives/

# ci/ holds importable modules now (synth_gate is imported by its entry points)
__pycache__/

# ASAP7 collateral fetched by hw/syn/libs/asap7/install.sh (never vendored)
hw/syn/libs/asap7/downloads/
hw/syn/libs/asap7/lib/
hw/syn/libs/asap7/verilog/
hw/syn/libs/asap7/metadata/
hw/syn/libs/asap7/.installed_*
hw/syn/libs/asap7/install.sh

# PQC experiment outputs. Raw runner logs are large and regenerable; the
# manifest and the derived numbers are the record and stay tracked.
pqc/results/*/raw/
pqc/results/*/figures/

# Local Vivado/simulator outputs.
/hd_visual/
/wdi_info.xml
/ramulator.stats.log

# Editor builds and rendering scratch; named release PDFs remain tracked.
/pqc/docs/dac_paper2/tmp/
/pqc/docs/dac_paper2/out/
/pqc/docs/dac_paper2/main.pdf
/pqc/docs/dac_paper2/main.synctex.gz
